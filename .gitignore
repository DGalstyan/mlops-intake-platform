# --- Secrets (guardrail: nothing credential-shaped is ever committed) ---
.env
.env.*
*.pem
*.key
credentials
aws_credentials
secrets.auto.tfvars
*.secrets.tfvars

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — the pinned provider
# hashes are part of "reproducible from a clean account" (IaC = 15%).
# NOTE: infra/envs/*.tfvars are deliberately NOT ignored — per-environment
# var-files are config, not secrets. Keep account ids out of them.
terraform.tfvars

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Model / data artifacts ---
# Deliberately not committed: the generator is deterministic, so `make data`
# reproduces byte-identical documents from the seed in src/config.py, and the
# snapshot id proves it. Committing ~100k of regenerable JSONL would add noise
# to every diff for no reproducibility gain — the snapshot id in the registry
# is what ties a model to its data.
/data/
/artifacts/
/build/
model.tar.gz
*.joblib
*.pkl
.local/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
