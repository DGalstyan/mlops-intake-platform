{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intake.example/schemas/id_document.json",
  "title": "id_document",
  "description": "Fields extracted from a government-issued identity document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "document_number", "full_name", "date_of_birth", "expiry_date", "issuing_country"],
  "properties": {
    "document_type": {
      "type": "string",
      "description": "Kind of identity document.",
      "enum": ["passport", "drivers_licence", "national_id", "residence_permit"]
    },
    "document_number": {
      "type": "string",
      "description": "Document number as printed.",
      "minLength": 1,
      "maxLength": 64
    },
    "full_name": {
      "type": "string",
      "description": "Holder's name as printed on the document.",
      "minLength": 1,
      "maxLength": 200
    },
    "date_of_birth": {
      "type": "string",
      "description": "ISO 8601 date.",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "expiry_date": {
      "type": "string",
      "description": "ISO 8601 date. The Validate state cross-checks this against date_of_birth for ordering, which is one of the field-level rules rather than a schema constraint because JSON Schema cannot express it.",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "issuing_country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-3 country code.",
      "pattern": "^[A-Z]{3}$"
    },
    "machine_readable_zone": {
      "type": ["string", "null"],
      "description": "Raw MRZ lines when present, newline-separated.",
      "maxLength": 200
    }
  }
}
